{
  "schema_version": 2,
  "training_version": "adaptive_augmented_3s_generic_v2",
  "microbatch_size": 4,
  "sampler": {
    "name": "HybridShardAwareSpeakerBatchSampler",
    "seed": 20260729,
    "speakers_per_batch": 16,
    "samples_per_speaker": 2,
    "active_shard_window": 8,
    "batches_per_epoch": "auto"
  },
  "model": {
    "source": "speechbrain/spkrec-ecapa-voxceleb",
    "embedding_dim": 192
  },
  "aam": {
    "num_classes": "auto",
    "margin": 0.2,
    "scale": 30.0
  },
  "optimizer": {
    "name": "AdamW",
    "ecapa_lr": 0.00001,
    "aam_lr": 0.001,
    "weight_decay": 0.0001
  },
  "amp": {
    "enabled": true,
    "ecapa_dtype": "float16",
    "grad_scaler_initial_scale": 128.0
  },
  "scheduler": {
    "name": "cosine",
    "max_epochs": 20,
    "steps_per_epoch": "auto",
    "total_steps": "auto",
    "minimum_factor": 0.1,
    "warmup_steps": 0
  },
  "early_stopping": {
    "patience": 2,
    "min_improvement_eer": 0.0001
  },
  "validation": {
    "trial_count": "auto",
    "batch_size": 64
  },
  "checkpoint_interval_updates": 100,
  "log_every_updates": 25
}
